# Szablon zmiennych środowiskowych
# Źródło: shared/standards/DEVELOPMENT_STANDARDS.md, sekcja 8.5
# Użycie: skopiuj do .env w korzeniu projektu i uzupełnij wartości
# UWAGA: plik .env NIE jest commitowany (jest w .gitignore)

# --- Baza danych (odkomentuj jeśli potrzebne) ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# --- Klucze API (odkomentuj jeśli potrzebne) ---
# API_KEY=
# SECRET_KEY=

# --- Środowisko ---
# ENV=development
